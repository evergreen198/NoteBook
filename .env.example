# ===== 必须修改 =====
# JWT 签名密钥:生产环境务必换成足够长的随机字符串
# 生成方法: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL 连接串(Railway 会自动注入,本地开发需手动填写)
# 格式: postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://postgres:password@localhost:5432/notebook

# ===== 可选 =====
# 服务器端口
# PORT=3001

# 是否开放注册(单用户模式:注册完自己的账号后设为 false)
ALLOW_REGISTRATION=true
